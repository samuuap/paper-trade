# Copy to .env and adjust. Every value here has a working default in
# app/core/config.py; this file documents the ones you are most likely to change.

# ---------------------------------------------------------------- general
ENV=local
LOG_LEVEL=INFO
LOG_JSON=false

# --------------------------------------------------------------- database
# Docker Compose overrides the host to `db`. Locally this points at a
# Postgres/TimescaleDB you are running yourself.
DATABASE_URL=postgresql+asyncpg://paper:paper@localhost:5432/papertrade

# ----------------------------------------------------------- market data
# Free tier: https://finnhub.io/register — 60 req/min, ~50 websocket symbols.
FINNHUB_API_KEY=
# Serve deterministic synthetic prices instead of calling out. Lets the whole
# system run with no API key, which is how the replay and the tests work.
MARKET_DATA_OFFLINE=false
# /stock/candle is premium. Leave false on the free tier: daily bars are
# assembled from /quote after the close instead. See app/orchestrator/ingest.py
# for what that costs you in indicator history.
FINNHUB_CANDLES_ENABLED=false

# --------------------------------------------------------------- trading
INITIAL_CAPITAL=100000
SLIPPAGE_BPS=5
MAX_POSITION_PCT=0.20
MAX_ORDERS_PER_CYCLE=5
ALLOW_SHORT=false

# ------------------------------------------------------------- inference
# llama-server exposing an OpenAI-compatible API. From inside Docker on macOS
# the host is reachable as host.docker.internal.
LLM_BASE_URL=http://host.docker.internal:8080/v1
LLM_API_KEY=sk-no-key-required
LLM_MODEL_OPEN=qwen3-14b-instruct-q4_k_m
LLM_MODEL_CLOSED=qwen3-30b-a3b-instruct-q4_k_m
# grammar | json_schema | none. `grammar` is the point of the design; the
# others exist to measure what it buys you.
STRUCTURED_MODE=grammar

# ---------------------------------------------------------- shadow cost
# What the same call would have cost on a frontier API, in USD per million
# tokens. Used for the cost-per-dollar-of-P&L metric.
SHADOW_MODEL_NAME=claude-sonnet-5
SHADOW_COST_INPUT_PER_MTOK=3.0
SHADOW_COST_OUTPUT_PER_MTOK=15.0
ELECTRICITY_COST_PER_KWH=0.18

# ---------------------------------------------------------- orchestrator
RUN_ORCHESTRATOR=true
DECISION_INTERVAL_MINUTES=15
EQUITY_SNAPSHOT_SECONDS=60
# Refuse to schedule inference below this much free RAM, and never load the
# large model if it would not fit.
MIN_FREE_MEMORY_GB=4

# Replay: drive the phase machine from a cursor instead of the wall clock.
# Pair with MARKET_DATA_OFFLINE=true for a run that needs no network at all.
REPLAY_MODE=false
REPLAY_START=
REPLAY_END=
REPLAY_SPEED=60

# ------------------------------------------------------------------- api
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000
